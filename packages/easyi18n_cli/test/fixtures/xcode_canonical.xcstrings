    },
    "Voz y conversación" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voice and conversation"
          }
        }
      }
    },
    "Vuelve a tocar el dorso mientras vibra y la llamada se cancela: notarás dos vibraciones seguidas en vez de una." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the back of your device again while it vibrates and the call is cancelled: you'll feel two vibrations in a row instead of one."
          }
        }
      }
    },
